.idea/
*.iml
*.iws
*.ipr
.vscode/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Local secrets. authToken and friends belong in environment variables, never in a file.
*.local.properties
.env

.bar2-report
.bar2-json-reports